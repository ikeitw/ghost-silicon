// cmd/ghost-silicon/resource.rc
// Embeds the application manifest and sets the executable icon.
// The go generate line below compiles this with windres (part of MSYS2/MinGW).

#include <windows.h>

// Manifest — ID 1 is the magic value Windows looks for at load time.
1 RT_MANIFEST "../../deployments/windows/ghost-silicon.exe.manifest"